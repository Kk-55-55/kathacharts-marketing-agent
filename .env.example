# Admin / runtime
AGENT_ADMIN_KEY=change-this-to-a-long-random-secret
NODE_ENV=production
PORT=3100
HUNT_INTERVAL_MINUTES=30
DATA_FILE=/var/data/agent-data.json

# KathaCharts
KATHACHARTS_URL=https://kathacharts.com
AGENT_PUBLIC_URL=https://YOUR-AGENT-DOMAIN.onrender.com

# AI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Semi-autonomous publishing
# After you approve a draft, the agent can publish it automatically through configured official APIs.
AUTO_PUBLISH=false
AUTO_PUBLISH_CHANNELS=instagram,facebook,x

# Meta / Instagram + Facebook Page
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=
# Public HTTPS image URL required for Instagram image publishing
INSTAGRAM_IMAGE_URL=

# X API OAuth 1.0a user credentials
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
