# Required for deployed/public use
AGENT_ADMIN_KEY=change-this-to-a-long-random-secret
NODE_ENV=production

# KathaCharts
KATHACHARTS_URL=https://kathacharts.com

# Optional AI campaign generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Runtime
PORT=3100
HUNT_INTERVAL_MINUTES=30

# Optional persistent data location
# DATA_FILE=/var/data/agent-data.json
